#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
CONFIG_MONA_DTB=y
CONFIG_SCHED_MOTO_UNFAIR=m
CONFIG_UFSFEATURE=y
CONFIG_UFSHID=y
CONFIG_MICRON_UFSHID=y
CONFIG_SCSI_SKHID=y

# Allow manual fake_soc reporting; inactive until explicitly set via sysfs.
# Also enables PMIC GLINK client debugfs controls; see the fake-SOC guide
# linked in the repository README.md.
CONFIG_QTI_PMIC_GLINK_CLIENT_DEBUG=y

# USB serial / Klipper MCU support
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y

# Klipper / SocketCAN support
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_DEV=y
CONFIG_CAN_GS_USB=y
CONFIG_CAN_SLCAN=y

# USB webcam support
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_VIDEO_DEV=y
# CONFIG_VIDEO_V4L2 is absent in this kernel; CONFIG_VIDEO_DEV provides V4L2.
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y

# USB storage bridges / SSDs
CONFIG_USB_UAS=y

# Expose CDC ACM gadget serial from the phone
CONFIG_USB_CONFIGFS_ACM=y
